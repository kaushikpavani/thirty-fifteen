# Dedicated Supabase project for 30/15 only.
# Do not use the BioAge project. Do not point these at any other app's database.
# Leave both blank to ride fully offline. The phone is the source of truth either way.
# Copy to .env.local and restart Expo. Both values are public; row level security protects rows.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
