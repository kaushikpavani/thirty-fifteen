{
  "expo": {
    "name": "ThirtyFifteen",
    "slug": "thirty-fifteen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "thirtyfifteen",
    "owner": "pavanikaushik",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-ios-dark.png",
        "tinted": "./assets/icon-ios-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.kaushikpavani.thirtyfifteen",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "30/15",
        "UIBackgroundModes": ["audio", "bluetooth-central"],
        "NSBluetoothAlwaysUsageDescription": "30/15 reads cycling power and heart rate from your sensors."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070708",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kaushikpavani.thirtyfifteen",
      "versionCode": 1,
      "backgroundColor": "#070708",
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "thirtyfifteen",
              "host": "auth-callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "30/15"
    },
    "extra": {
      "eas": {
        "projectId": "5fe5855e-1f9e-417f-b31d-abf10c597958"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070708",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-router",
      "expo-apple-authentication",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-web-browser",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "30/15 reads cycling power and heart rate from your sensors.",
          "neverForLocation": true
        }
      ],
      ["./plugins/withAndroidLabel", "30/15 Coach"],
      "./plugins/withAndroidRelease"
    ]
  }
}
